{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claudeboy",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-21",
  "observability": { "enabled": true },
  // The board and the watch both hit this hostname. The zone already carries a
  // proxied wildcard, which a Custom Domain overrides -- four other Workers on
  // dannonbaker.com do the same thing.
  "routes": [
    { "pattern": "claudeboy.dannonbaker.com", "custom_domain": true }
  ],
  // Created with `npx wrangler kv namespace create SNAPSHOTS`. No preview
  // namespace: `wrangler dev` uses local storage under .wrangler/ by default.
  "kv_namespaces": [
    { "binding": "SNAPSHOTS", "id": "7ff0ba3ec8504fd7aa2e670a1e8a1f9c" }
  ]
  // Secrets are NOT declared here. Set them with:
  //   npx wrangler secret put CLAUDEBOY_PUSH_TOKEN
  //   npx wrangler secret put CLAUDEBOY_READ_TOKEN
  // For local `wrangler dev`, put them in server/.dev.vars (git-ignored).
}
