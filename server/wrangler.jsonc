{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claudeboy",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-21",
  "observability": { "enabled": true },
  // Created with:
  //   npx wrangler kv namespace create SNAPSHOTS
  // Paste the printed id here. There is no preview namespace: `wrangler dev`
  // uses local storage under .wrangler/ by default.
  "kv_namespaces": [
    { "binding": "SNAPSHOTS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]
  // Secrets are NOT declared here. Set them with:
  //   npx wrangler secret put CLAUDEBOY_PUSH_TOKEN
  //   npx wrangler secret put CLAUDEBOY_READ_TOKEN
  // For local `wrangler dev`, put them in server/.dev.vars (git-ignored).
}
