// The cyd-ble build needs none of this -- it takes its data from the MacBook over
// a bonded BLE link, so there is no SSID, no password and no read token in the
// firmware. Only the WiFi build (-e cyd) reads these.
#pragma once
// Copy to secrets.h (git-ignored) and fill in. Values live in
// ~/work/envs/claudeboy.env -- CLAUDEBOY_URL and CLAUDEBOY_READ_TOKEN.
#define CB_WIFI_SSID      "your-ssid"
#define CB_WIFI_PASSWORD  "your-password"
#define CB_API_HOST       "claudeboy.dannonbaker.com"
#define CB_API_PATH       "/v1/snapshot?client=cyd"
#define CB_READ_TOKEN     "paste-the-read-token"
